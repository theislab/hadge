/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple genetic demultiplexing test.

    Use as follows:
        nextflow run nf-core/hadge -profile test_genetic,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test genetic mode'
    config_profile_description = 'Minimal test dataset to check pipeline function of all genetic deconvolution methods in genetic mode'

    // Input data
    mode          = 'genetic'
    genetic_tools = 'demuxlet,freemuxlet,vireo,souporcell'
    input         = 'https://github.com/nf-core/test-datasets/raw/refs/heads/hadge/samplesheet/samplesheet_genetic.csv'
    genome        = 'GRCh38'
    fasta         = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/genome.fasta'
    outdir        = "outdir_test_genetic"
}
