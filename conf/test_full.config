/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/hadge -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 60,
        memory: '220.GB',
        time: '23.h'
    ]

    withName: UMITOOLS_DEDUP {
        cpus = 16
        memory = 128.GB
        time = 23.h
    }

    withName: POPSCLE_DSCPILEUP {
        cpus = 16
        memory = 220.GB
        time = 23.h
    }

    withName: SOUPORCELL {
        cpus = 60
        memory = 128.GB
        time = 23.h
    }

    withName: POPSCLE_FREEMUXLET {
        cpus = 60
        memory = 220.GB
        time = 23.h
    }


    withName: POPSCLE_DEMUXLET {
        cpus = 60
        memory = 220.GB
        time = 23.h
    }
}

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Input data
    mode               = 'rescue'
    hash_tools         = 'htodemux,hasheddrops,multiseq,demuxem,gmm-demux,bff,hashsolo'
    genetic_tools      = 'freemuxlet,vireo,souporcell'
    input              = '/lustre/groups/ml01/code/luis.heinzlmeier/hadge/conf/test_full_new.csv'
    genome             = 'GRCh38'
    bam_qc             = false
    outdir             = "outdir_test_full"
    find_variants      = false
}
